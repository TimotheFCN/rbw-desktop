#!/usr/bin/env bash
# Screenshots rbw-desktop on a private headless X server (Xvfb, software
# Vulkan), composited over a wallpaper. See docs/DEVELOPMENT.md.
set -euo pipefail

usage() {
	cat <<'EOF'
usage: tools/shot [options] <state> <out.png>

states, in the vault:
  vault          the vault of an unlocked account
  search         "bank" typed into the search field
  logins         Logins chosen in the sidebar
  select         the third item selected with the keyboard
  copied         the first field of the item copied
  revealed       the item's password shown
  sheet          the New Item sheet
  sheet-options  its password options
  add-field      its Add Field menu
  folder-menu    the sheet's folder menu
  new-folder     a folder being created from it
  delete         asking before deleting the selected item
  accounts       the account menu
  sign-out       asking before signing out
  add-account    adding another account
  main-menu      GNOME's primary menu, in the sidebar's header bar
  item-menu      the selected item's context menu (Shift-F10)
  move-menu      its folders, to move the item to one
  reprompt       an item that asks for the master password again
  reprompt-wrong a wrong master password for it
  no-icons       the vault with website icons off
  generator      the password generator's popover

locking and signing in:
  lock           the lock screen
  lock-wrong     a wrong password entered
  lock-busy      unlocking, with a slow backend
  lock-touch-id  Touch ID ready to unlock, its prompt canceled
  lock-accounts  the account menu from the lock screen
  unlock         the vault, unlocked with the password
  first-run      no accounts yet: the server and email
  self-hosted    a self-hosted server chosen
  password       the master password step
  sign-in-wrong  a wrong master password
  offline        the server can't be reached
  wrong-server   a self-hosted address with no Bitwarden server, back at it
  two-step       the two-step login code step
  email-code     a two-step code by email, sent
  new-device     the new device code step
  api-key        the server asks for the account's API key
  signed-out     signing in to an account that is signed out
  no-rbw         rbw isn't installed
  old-rbw        rbw is too old

the menu bar panel, opened alone:
  panel          its passwords: the items used last
  panel-search   "git" typed into its search
  panel-copied   the first item's password copied
  panel-locked   the account locked
  panel-touch-id locked, with Touch ID ready
  panel-signed-out nobody signed in
  panel-generator its generator
  panel-passphrase the generator making a passphrase

settings, in their own window:
  settings           General
  settings-lock      General, the lock timeout's menu open
  settings-accounts  Accounts
  settings-touch-id  Accounts, with Touch ID to turn on or off
  settings-ssh       SSH Agent, set up and used by ssh
  ssh-off            SSH Agent, not set up
  ssh-setting-up     setting it up
  ssh-fails          setting it up failed
  ssh-elsewhere      set up, but ssh uses another agent
  ssh-other          set up for the other account
  ssh-unsupported    the system can't run it
  ssh-remove         asking before removing it
  settings-about     About

  gallery        the design system gallery

options:
  --theme T     macos-light (default), macos-dark, gnome-light, gnome-dark
  --size WxH    window size in points, frame included (default: the app's)
  --scale N     pixels per point (default 2)
  --then ARGS   after the state, run `xdotool ARGS`, such as
                --then 'type "Zebra Club"' or --then 'key ctrl+Return'; $window
                and $scale are set; repeatable, run in order
  --record S    also record S seconds from the state's input as
                <out>-frames/NNN.png at 30 frames per second
  --demo WORDS  more RBW_DESKTOP_DEMO words (see crates/app/src/demo.rs),
                such as slow
  --keyboard    rest the pointer before the input rather than after it: a
                pointer that moves hides the keyboard's focus ring
  --tray        run a stand-in system tray, which shows the app's item
  --no-build    use the binaries already built
  --binary PATH run this rbw-desktop, such as a package's, and build nothing
EOF
	exit 2
}

theme=macos-light size="" scale=2 record="" build=1 then=() demo="" tray=0 keyboard=0 binary=""
while [[ $# -gt 0 && $1 == --* ]]; do
	case $1 in
	--theme) theme=$2; shift 2 ;;
	--size) size=$2; shift 2 ;;
	--scale) scale=$2; shift 2 ;;
	--record) record=$2; shift 2 ;;
	--then) then+=("$2"); shift 2 ;;
	--demo) demo=$2; shift 2 ;;
	--tray) tray=1; shift ;;
	--keyboard) keyboard=1; shift ;;
	--no-build) build=0; shift ;;
	--binary) binary=$(realpath "$2") build=0; shift 2 ;;
	*) usage ;;
	esac
done
[[ $# -eq 2 ]] || usage
state=$1 out=$(realpath -m "$2")

root=$(cd "$(dirname "$0")/.." && pwd)
export PATH="$HOME/.cargo/bin:$PATH" CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8}
if [[ $state == gallery ]]; then
	binary=$root/target/debug/examples/gallery title=Gallery
	((build)) && cargo build --quiet --manifest-path "$root/Cargo.toml" -p rbw-desktop-ui --example gallery
else
	binary=${binary:-$root/target/debug/rbw-desktop} title=Vault
	[[ $state == panel* ]] && title=Fastwarden
	((build)) && cargo build --quiet --manifest-path "$root/Cargo.toml" -p rbw-desktop
fi

# shellcheck source=tools/lib/x11.sh
source "$root/tools/lib/x11.sh"
case $theme in macos-light | macos-dark | gnome-light | gnome-dark) ;; *) usage ;; esac
x11_start

# Each state starts from the demo setup it needs.
case $state in
lock | lock-wrong | lock-accounts | unlock | gallery) state_demo="" ;;
no-rbw | old-rbw) state_demo=$state ;;
no-icons) state_demo=unlocked,no-icons ;;
ssh-off) state_demo=unlocked,ssh-off ;;
ssh-setting-up) state_demo=unlocked,ssh-off,ssh-slow ;;
ssh-fails) state_demo=unlocked,ssh-off,ssh-fails ;;
ssh-elsewhere) state_demo=unlocked,ssh-elsewhere ;;
ssh-unsupported) state_demo=unlocked,ssh-unsupported ;;
lock-busy) state_demo=slow ;;
lock-touch-id) state_demo=touch-id-cancel ;;
settings-touch-id) state_demo=touch-id ;;
panel | panel-search | panel-copied | panel-generator | panel-passphrase) state_demo=unlocked,panel ;;
panel-locked) state_demo=panel ;;
panel-touch-id) state_demo=touch-id,panel ;;
panel-signed-out) state_demo=first-run,panel ;;
first-run | self-hosted | password | sign-in-wrong | two-step | email-code | new-device | api-key)
	state_demo=first-run
	;;
offline) state_demo=first-run,offline ;;
wrong-server) state_demo=first-run ;;
signed-out) state_demo=first-run,signed-out ;;
*) state_demo=unlocked ;;
esac
export RBW_DESKTOP_DEMO=$state_demo,$demo

((tray)) && x11_tray
x11_launch "$binary"
x11_window "^$title\$"
if [[ -n $size ]]; then
	xdotool windowsize "$window" $((${size%x*} * scale)) $((${size#*x} * scale))
	x11_window "^$title\$"
fi
sleep 1.5

# Settings states shoot the Settings window, opened with its shortcut.
case $state in
settings* | ssh-*)
	xdotool key ctrl+comma
	main=$window
	x11_window '^(Settings|Preferences)$' 10
	if [[ -n $size ]]; then
		xdotool windowsize "$window" $((${size%x*} * scale)) $((${size#*x} * scale))
		x11_window '^(Settings|Preferences)$'
	fi
	# Out of the picture.
	xdotool windowmove "$main" "$screen_w" 0
	sleep 1
	;;
esac

# Where things are, in points.
case $theme in
macos-*) toolbar=50 sidebar=180 sidebar_top=50 nav=32 ;;
gnome-*) toolbar=46 sidebar=196 sidebar_top=46 nav=32 ;;
esac
click() { x11_click "$@"; }
# Shows the settings page at this index, with the keyboard: Tab from the
# window reaches the list of pages. Then `into_page N` moves the keyboard to
# the page's Nth control, past the other pages and, on GNOME, the header
# bar's window buttons.
settings_page() {
	page=$1
	local tabs=()
	for _ in $(seq 0 "$1"); do tabs+=(Tab); done
	xdotool key "${tabs[@]}" Return
	sleep 0.5
}
into_page() {
	local count=$((3 - page + $1)) tabs=()
	[[ $theme == gnome-* ]] && count=$((count + 3))
	for _ in $(seq "$count"); do tabs+=(Tab); done
	xdotool key "${tabs[@]}"
}
act() {
	((keyboard)) && x11_rest_pointer
	# The window's size in points, without the frame.
	local width=$((win_w / scale - 2 * frame)) height=$((win_h / scale - 2 * frame))
	# The item list: its default share of the room right of the sidebar.
	local list=$(((width - sidebar) * 40 / 100))
	((list < 240)) && list=240
	# The middle of the account button at the bottom of the sidebar.
	local footer_x=60 footer_y=$((height - 7 - 19))
	case $state in
	vault | gallery | lock | lock-touch-id | first-run | signed-out | no-rbw | old-rbw | no-icons) ;;
	panel | panel-locked | panel-touch-id | panel-signed-out) ;;
	panel-search) xdotool type --delay 60 git ;;
	panel-copied) xdotool key Return ;;
	# The tabs come before the search field, one stop at the tab shown, and
	# the arrow keys choose; then the Copy button has the keyboard, and the
	# kinds come after it and Generate Another.
	panel-generator) xdotool key shift+Tab Right ;;
	panel-passphrase) xdotool key shift+Tab Right sleep 0.4 key Tab Tab Right ;;
	main-menu) click $((sidebar - 24)) $((toolbar / 2)) ;;
	# The Menu key: under Xvfb, xdotool's Shift-F10 arrives with Alt.
	item-menu) xdotool key Down Down Down Menu ;;
	# Copy Username, Copy Password, Add to Favorites, then Move to Folder.
	move-menu) xdotool key Down Down Down Menu sleep 0.4 key Down Down Down Down Return ;;
	reprompt | reprompt-wrong)
		xdotool key ctrl+f type --delay 60 bank
		xdotool key Return
		# Clicking the item gives its password field the keyboard.
		[[ $state == reprompt-wrong ]] &&
			click $((sidebar + 120)) $((toolbar + 25)) &&
			xdotool sleep 0.4 type --delay 40 nope && xdotool key Return sleep 0.6
		;;
	# Tab goes through the pages, then each page's controls.
	settings) settings_page 0 ;;
	settings-lock) settings_page 0 && into_page 1 && xdotool key Return ;;
	settings-accounts | settings-touch-id) settings_page 1 ;;
	settings-ssh | ssh-off | ssh-elsewhere | ssh-unsupported) settings_page 2 ;;
	# The account chooser, then the button.
	ssh-setting-up | ssh-fails) settings_page 2 && into_page 2 && xdotool key Return ;;
	ssh-other) settings_page 2 && into_page 1 && xdotool key Return sleep 0.4 key Down Down Return ;;
	ssh-remove) settings_page 2 && into_page 2 && xdotool key Return ;;
	settings-about) settings_page 3 ;;
	search) xdotool key ctrl+f type --delay 60 bank ;;
	# The fourth row: All Items, Favorites, the Types heading, Logins.
	logins) click $((sidebar / 2)) $((sidebar_top + nav * 2 + 30 + nav / 2)) ;;
	select) xdotool key Down Down ;;
	# The first field: under the toolbar, the 56-point header and its gap.
	copied) click $((sidebar + list + 100)) $((toolbar + 2 + 56 + 4 + 10 + 20)) ;;
	# The eye of the second field, the password.
	revealed) click $((width - 62)) $((toolbar + 2 + 56 + 4 + 10 + 51 + 25)) ;;
	sheet) xdotool key ctrl+n ;;
	generator) xdotool key ctrl+shift+g ;;
	# Name, Username, Password, its Generate and Options buttons, Website,
	# then Folder.
	# The sheet's stops of Tab: the name, the kinds, the username, the
	# password and its three buttons, the website, the notes, Add Field,
	# the folder.
	sheet-options) xdotool key ctrl+n sleep 0.4 key Tab Tab Tab Tab Tab Tab Return ;;
	add-field) xdotool key ctrl+n sleep 0.4 key Tab Tab Tab Tab Tab Tab Tab Tab Tab Return ;;
	folder-menu) xdotool key ctrl+n sleep 0.4 key Tab Tab Tab Tab Tab Tab Tab Tab Tab Tab Return ;;
	new-folder)
		xdotool key ctrl+n sleep 0.4 key Tab Tab Tab Tab Tab Tab Tab Tab Tab Tab Return sleep 0.4 key Up Return
		xdotool sleep 0.4 type --delay 60 Travel
		;;
	delete) xdotool key ctrl+BackSpace ;;
	accounts) click "$footer_x" "$footer_y" ;;
	# Up from the menu goes round to its last items.
	sign-out) click "$footer_x" "$footer_y" && xdotool sleep 0.4 key Up Return ;;
	add-account) click "$footer_x" "$footer_y" && xdotool sleep 0.4 key Up Up Return ;;
	lock-wrong) xdotool type --delay 40 nope && xdotool key Return sleep 0.6 ;;
	lock-busy) xdotool sleep 2 type --delay 40 demo && xdotool key Return ;;
	lock-accounts) xdotool key shift+Tab Return ;;
	unlock) xdotool type --delay 40 demo && xdotool key Return ;;
	# The servers, one stop of Tab, then Self-hosted with the arrow keys.
	self-hosted) xdotool key shift+Tab Right Right ;;
	password) xdotool type --delay 40 alex@example.org && xdotool key Return ;;
	sign-in-wrong | two-step | email-code)
		xdotool type --delay 40 alex@example.org && xdotool key Return sleep 0.4
		xdotool type --delay 40 "$([[ $state == sign-in-wrong ]] && echo nope || echo demo)"
		xdotool key Return sleep 0.6
		# The Email method, then its button.
		[[ $state == email-code ]] && xdotool key shift+Tab Right sleep 0.3 key Tab Return
		;;
	wrong-server)
		xdotool key shift+Tab Right Right
		xdotool type --delay 40 vault.example.invalid && xdotool key Tab
		xdotool type --delay 40 alex@example.org && xdotool key Return sleep 0.4
		xdotool type --delay 40 demo && xdotool key Return sleep 0.6
		;;
	offline)
		xdotool type --delay 40 alex@example.org && xdotool key Return sleep 0.4
		xdotool type --delay 40 demo && xdotool key Return sleep 0.4
		;;
	new-device | api-key)
		# The demo asks for a device code or an API key by the email.
		local tag=device
		[[ $state == api-key ]] && tag=apikey
		xdotool type --delay 40 "alex+$tag@example.org" && xdotool key Return sleep 0.4
		xdotool type --delay 40 demo && xdotool key Return
		;;
	*) usage ;;
	esac
	for args in "${then[@]}"; do
		sleep 0.4
		eval "xdotool $args"
	done
	((keyboard)) || x11_rest_pointer
}

if [[ -n $record ]]; then
	margin=$((40 * scale))
	x11_geometry
	frames="${out%.png}-frames"
	rm -rf "$frames" && mkdir -p "$frames"
	ffmpeg -loglevel error -f x11grab -framerate 30 \
		-video_size "$((win_w + 2 * margin))x$((win_h + 2 * margin))" \
		-i "$DISPLAY+$((win_x - margin)),$((win_y - margin))" -t "$record" "$frames/%03d.png" &
	recorder=$!
	sleep 0.3
	act
	wait "$recorder"
	echo "$frames"
else
	act
fi
sleep 1

x11_capture "$out"
echo "$out"
